REP ^dinanŧi$ dʼ_inanŧi


FLAG long


# avoid wrong spelling of letterwords (km, GHz, DVD, ...)
KEEPCASE Z0

NEEDAFFIX Z1

ONLYINCOMPOUND Z2

# `-` is part of a word, this line avoid marking a lone `–` as an error
NOSUGGEST NS


# donʼt compound on case–different word borders
CHECKCOMPOUNDCASE

# minimum length of words in compound words
COMPOUNDMIN 2

# numerali konpòsti:
# n1/|1 = [un..ŧinkue..nòve]  [un..sinkue..nòve]
# n2/|2 = [do..ŧinkue..nòve]  [do..sinkue..nòve]
# n3/|3 = [dièxe..dixnòve] + [vinti..ŧinkuanta..novanta]  [dièxe..dixnòve] + [vinti..sinkuanta..novanta]
# n4/|4 = [vinti..ŧinkuanta..novanta]  [vinti..sinkuanta..novanta]
# n5/|5 = ŧento  sento
# n6/|6 = mi[lƚ][ei]  mi[lƚ]ia
COMPOUNDRULE 80
COMPOUNDRULE (n4)(-b)(n1)	# [vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]
COMPOUNDRULE (n5)(-b)(n1)	# ŧento‒[un..ŧinkue..nòve]
COMPOUNDRULE (n5)(-b)(n3)	# ŧento‒[dièxe..dixnòve+vinti..ŧinkuanta..novanta]
COMPOUNDRULE (n5)(-b)(n4)(-b)(n1)	# ŧento‒[vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]
COMPOUNDRULE (n2)(-b)(n5)	# [do..ŧinkue..nòve]‒ŧento
COMPOUNDRULE (n2)(-b)(n5)(-b)(n1)	# [do..ŧinkue..nòve]‒ŧento‒[un..ŧinkue..nòve]
COMPOUNDRULE (n2)(-b)(n5)(-b)(n3)	# [do..ŧinkue..nòve]‒ŧento‒[dièxe..dixnòve+vinti..ŧinkuanta..novanta]
COMPOUNDRULE (n2)(-b)(n5)(-b)(n4)(-b)(n1)	# [do..ŧinkue..nòve]‒ŧento‒[vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]
COMPOUNDRULE (n6)(-b)(n1)	# mile‒[un..ŧinkue..nòve]
COMPOUNDRULE (n6)(-b)(n3)	# mile‒[dièxe..dixnòve+vinti..ŧinkuanta..novanta]
COMPOUNDRULE (n6)(-b)(n4)(-b)(n1)	# mile‒[vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]
COMPOUNDRULE (n6)(-b)(n5)	# mile‒ŧento
COMPOUNDRULE (n6)(-b)(n5)(-b)(n1)	# mile‒ŧento‒[un..ŧinkue..nòve]
COMPOUNDRULE (n6)(-b)(n5)(-b)(n3)	# mile‒ŧento‒[dièxe..dixnòve+vinti..ŧinkuanta..novanta]
COMPOUNDRULE (n6)(-b)(n5)(-b)(n4)(-b)(n1)	# mile‒ŧento‒[vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]
COMPOUNDRULE (n6)(-b)(n2)(-b)(n5)(-b)(n1)	# mile‒[do..ŧinkue..nòve]‒ŧento‒[un..ŧinkue..nòve]
COMPOUNDRULE (n6)(-b)(n2)(-b)(n5)(-b)(n3)	# mile‒[do..ŧinkue..nòve]‒ŧento‒[dièxe..dixnòve+vinti..ŧinkuanta..novanta]
COMPOUNDRULE (n6)(-b)(n2)(-b)(n5)(-b)(n4)(-b)(n1)	# mile‒[do..ŧinkue..nòve]‒ŧento‒[vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]
COMPOUNDRULE (n2)(-b)(n6)	# [do..ŧinkue..nòve]‒mile
COMPOUNDRULE (n3)(-b)(n6)	# [dièxe..dixnòve+vinti..ŧinkuanta..novanta]‒mile
COMPOUNDRULE (n4)(-b)(n1)(-b)(n6)	# [vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]‒mile
COMPOUNDRULE (n2)(-b)(n6)(-b)(n1)	# [do..ŧinkue..nòve]‒mile‒[un..ŧinkue..nòve]
COMPOUNDRULE (n2)(-b)(n6)(-b)(n3)	# [do..ŧinkue..nòve]‒mile‒[dièxe..dixnòve+vinti..ŧinkuanta..novanta]
COMPOUNDRULE (n2)(-b)(n6)(-b)(n4)(-b)(n1)	# [do..ŧinkue..nòve]‒mile‒[vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]
COMPOUNDRULE (n2)(-b)(n6)(-b)(n2)(-b)(n5)(-b)(n1)	# [do..ŧinkue..nòve]‒mile‒[do..ŧinkue..nòve]‒ŧento‒[un..ŧinkue..nòve]
COMPOUNDRULE (n2)(-b)(n6)(-b)(n2)(-b)(n5)(-b)(n3)	# [do..ŧinkue..nòve]‒mile‒[do..ŧinkue..nòve]‒ŧento‒[dièxe..dixnòve+vinti..ŧinkuanta..novanta]
COMPOUNDRULE (n2)(-b)(n6)(-b)(n2)(-b)(n5)(-b)(n4)(-b)(n1)	# [do..ŧinkue..nòve]‒mile‒[do..ŧinkue..nòve]‒ŧento‒[vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]
COMPOUNDRULE (n3)(-b)(n6)(-b)(n1)	# [dièxe..dixnòve+vinti..ŧinkuanta..novanta]‒mile‒[un..ŧinkue..nòve]
COMPOUNDRULE (n3)(-b)(n6)(-b)(n3)	# [dièxe..dixnòve+vinti..ŧinkuanta..novanta]‒mile‒[dièxe..dixnòve+vinti..ŧinkuanta..novanta]
COMPOUNDRULE (n3)(-b)(n6)(-b)(n4)(-b)(n1)	# [dièxe..dixnòve+vinti..ŧinkuanta..novanta]‒mile‒[vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]
COMPOUNDRULE (n3)(-b)(n6)(-b)(n2)(-b)(n5)(-b)(n1)	# [dièxe..dixnòve+vinti..ŧinkuanta..novanta]‒mile‒[do..ŧinkue..nòve]‒ŧento‒[un..ŧinkue..nòve]
COMPOUNDRULE (n3)(-b)(n6)(-b)(n2)(-b)(n5)(-b)(n3)	# [dièxe..dixnòve+vinti..ŧinkuanta..novanta]‒mile‒[do..ŧinkue..nòve]‒ŧento‒[dièxe..dixnòve+vinti..ŧinkuanta..novanta]
COMPOUNDRULE (n3)(-b)(n6)(-b)(n2)(-b)(n5)(-b)(n4)(-b)(n1)	# [dièxe..dixnòve+vinti..ŧinkuanta..novanta]‒mile‒[do..ŧinkue..nòve]‒ŧento‒[vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]
COMPOUNDRULE (n4)(-b)(n1)(-b)(n6)(-b)(n1)	# [vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]‒mile‒[un..ŧinkue..nòve]
COMPOUNDRULE (n4)(-b)(n1)(-b)(n6)(-b)(n3)	# [vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]‒mile‒[dièxe..dixnòve+vinti..ŧinkuanta..novanta]
COMPOUNDRULE (n4)(-b)(n1)(-b)(n6)(-b)(n4)(-b)(n1)	# [vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]‒mile‒[vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]
COMPOUNDRULE (n4)(-b)(n1)(-b)(n6)(-b)(n2)(-b)(n5)(-b)(n1)	# [vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]‒mile‒[do..ŧinkue..nòve]‒ŧento‒[un..ŧinkue..nòve]
COMPOUNDRULE (n4)(-b)(n1)(-b)(n6)(-b)(n2)(-b)(n5)(-b)(n3)	# [vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]‒mile‒[do..ŧinkue..nòve]‒ŧento‒[dièxe..dixnòve+vinti..ŧinkuanta..novanta]
COMPOUNDRULE (n4)(-b)(n1)(-b)(n6)(-b)(n2)(-b)(n5)(-b)(n4)(-b)(n1)	# [vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]‒mile‒[do..ŧinkue..nòve]‒ŧento‒[vinti..ŧinkuanta..novanta]‒[un..ŧinkue..nòve]
COMPOUNDRULE (n5)(-b)(n6)	# ŧento-mile
COMPOUNDRULE (|4)(-b)(|1)	# [vinti..sinkuanta..novanta]‒[un..sinkue..nòve]
COMPOUNDRULE (|5)(-b)(|1)	# sento‒[un..sinkue..nòve]
COMPOUNDRULE (|5)(-b)(|3)	# sento‒[dièxe..dixnòve+vinti..sinkuanta..novanta]
COMPOUNDRULE (|5)(-b)(|4)(-b)(|1)	# sento‒[vinti..sinkuanta..novanta]‒[un..sinkue..nòve]
COMPOUNDRULE (|2)(-b)(|5)	# [do..sinkue..nòve]‒sento
COMPOUNDRULE (|2)(-b)(|5)(-b)(|1)	# [do..sinkue..nòve]‒sento‒[un..sinkue..nòve]
COMPOUNDRULE (|2)(-b)(|5)(-b)(|3)	# [do..sinkue..nòve]‒sento‒[dièxe..dixnòve+vinti..sinkuanta..novanta]
COMPOUNDRULE (|2)(-b)(|5)(-b)(|4)(-b)(|1)	# [do..sinkue..nòve]‒sento‒[vinti..sinkuanta..novanta]‒[un..sinkue..nòve]
COMPOUNDRULE (|6)(-b)(|1)	# mi[lƚ]e‒[un..sinkue..nòve]
COMPOUNDRULE (|6)(-b)(|3)	# mi[lƚ]e‒[dièxe..dixnòve+vinti..sinkuanta..novanta]
COMPOUNDRULE (|6)(-b)(|4)(-b)(|1)	# mi[lƚ]e‒[vinti..sinkuanta..novanta]‒[un..sinkue..nòve]
COMPOUNDRULE (|6)(-b)(|5)	# mi[lƚ]e‒sento
COMPOUNDRULE (|6)(-b)(|5)(-b)(|1)	# mi[lƚ]e‒sento‒[un..sinkue..nòve]
COMPOUNDRULE (|6)(-b)(|5)(-b)(|3)	# mi[lƚ]e‒sento‒[dièxe..dixnòve+vinti..sinkuanta..novanta]
COMPOUNDRULE (|6)(-b)(|5)(-b)(|4)(-b)(|1)	# mi[lƚ]e‒sento‒[vinti..sinkuanta..novanta]‒[un..sinkue..nòve]
COMPOUNDRULE (|6)(-b)(|2)(-b)(|5)(-b)(|1)	# mi[lƚ]e‒[do..sinkue..nòve]‒sento‒[un..sinkue..nòve]
COMPOUNDRULE (|6)(-b)(|2)(-b)(|5)(-b)(|3)	# mi[lƚ]e‒[do..sinkue..nòve]‒sento‒[dièxe..dixnòve+vinti..sinkuanta..novanta]
COMPOUNDRULE (|6)(-b)(|2)(-b)(|5)(-b)(|4)(-b)(|1)	# mi[lƚ]e‒[do..sinkue..nòve]‒sento‒[vinti..sinkuanta..novanta]‒[un..sinkue..nòve]
COMPOUNDRULE (|2)(-b)(|6)	# [do..sinkue..nòve]‒mi[lƚ]e
COMPOUNDRULE (|3)(-b)(|6)	# [dièxe..dixnòve+vinti..sinkuanta..novanta]‒mi[lƚ]e
COMPOUNDRULE (|4)(-b)(|1)(-b)(|6)	# [vinti..sinkuanta..novanta]‒[un..sinkue..nòve]‒mi[lƚ]e
COMPOUNDRULE (|2)(-b)(|6)(-b)(|1)	# [do..sinkue..nòve]‒mi[lƚ]e‒[un..sinkue..nòve]
COMPOUNDRULE (|2)(-b)(|6)(-b)(|3)	# [do..sinkue..nòve]‒mi[lƚ]e‒[dièxe..dixnòve+vinti..sinkuanta..novanta]
COMPOUNDRULE (|2)(-b)(|6)(-b)(|4)(-b)(|1)	# [do..sinkue..nòve]‒mi[lƚ]e‒[vinti..sinkuanta..novanta]‒[un..sinkue..nòve]
COMPOUNDRULE (|2)(-b)(|6)(-b)(|2)(-b)(|5)(-b)(|1)	# [do..sinkue..nòve]‒mi[lƚ]e‒[do..sinkue..nòve]‒sento‒[un..sinkue..nòve]
COMPOUNDRULE (|2)(-b)(|6)(-b)(|2)(-b)(|5)(-b)(|3)	# [do..sinkue..nòve]‒mi[lƚ]e‒[do..sinkue..nòve]‒sento‒[dièxe..dixnòve+vinti..sinkuanta..novanta]
COMPOUNDRULE (|2)(-b)(|6)(-b)(|2)(-b)(|5)(-b)(|4)(-b)(|1)	# [do..sinkue..nòve]‒mi[lƚ]e‒[do..sinkue..nòve]‒sento‒[vinti..sinkuanta..novanta]‒[un..sinkue..nòve]
COMPOUNDRULE (|3)(-b)(|6)(-b)(|1)	# [dièxe..dixnòve+vinti..sinkuanta..novanta]‒mi[lƚ]e‒[un..sinkue..nòve]
COMPOUNDRULE (|3)(-b)(|6)(-b)(|3)	# [dièxe..dixnòve+vinti..sinkuanta..novanta]‒mi[lƚ]e‒[dièxe..dixnòve+vinti..sinkuanta..novanta]
COMPOUNDRULE (|3)(-b)(|6)(-b)(|4)(-b)(|1)	# [dièxe..dixnòve+vinti..sinkuanta..novanta]‒mi[lƚ]e‒[vinti..sinkuanta..novanta]‒[un..sinkue..nòve]
COMPOUNDRULE (|3)(-b)(|6)(-b)(|2)(-b)(|5)(-b)(|1)	# [dièxe..dixnòve+vinti..sinkuanta..novanta]‒mi[lƚ]e‒[do..sinkue..nòve]‒sento‒[un..sinkue..nòve]
